{
  "name": "dsh-model-request-counter",
  "description": "Model usage dashboard for DeepSeek Harness: a Cordis client plugin adding the 使用统计 settings section (tokens, cost, latency, status per request), folded from stored session logs",
  "version": "2.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/index.js",
    "lib/types/client.js",
    "lib/usage-scan.js",
    "lib/pricing.js",
    "lib/dashboard.html",
    "lib/static/shared.js",
    "client/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.2 <0.3.0-0"
  }
}